cff-version: 1.2.0
message: "If you use this software, please cite it as below."
title: "OpenHydroNet: Riverine flood forecasting models of Google Flood Hub (googlehydrology)"
abstract: "Open-source implementation of the global streamflow forecasting models used in Google Flood Hub (Mean-Embedding-Forecast-LSTM, Handoff-Forecast-LSTM) with latent-space variational data assimilation. Fork of NeuralHydrology."
license: "Apache-2.0"
repository-code: "https://github.com/google-research/flood-forecasting"
keywords:
  - "hydrology"
  - "flood forecasting"
  - "streamflow"
  - "LSTM"
  - "data assimilation"
  - "Google Flood Hub"
